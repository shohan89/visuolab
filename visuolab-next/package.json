{
  "name": "visuolab-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "preview": "vite build && npm run db:migrate:preview && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run build",
    "cf-typegen": "wrangler types",
    "db:migration:new": "wrangler d1 migrations create visuolab",
    "db:migrate:local": "wrangler d1 migrations apply visuolab --local",
    "db:migrate:remote": "wrangler d1 migrations apply visuolab --remote",
    "db:list:local": "wrangler d1 migrations list visuolab --local",
    "db:migrate:preview": "wrangler d1 migrations apply visuolab --local --config dist/server/wrangler.json",
    "db:seed:generate": "node scripts/db/generate-seed.mjs",
    "db:seed:local": "wrangler d1 execute visuolab --local --file db/seed/content.sql",
    "db:seed:preview": "wrangler d1 execute visuolab --local --config dist/server/wrangler.json --file db/seed/content.sql",
    "db:seed:remote": "wrangler d1 execute visuolab --remote --file db/seed/content.sql",
    "db:verify": "node --no-warnings scripts/db/verify.mjs",
    "db:verify:local": "node --no-warnings scripts/db/verify.mjs --local",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.1",
    "lenis": "1.1.18",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "0.170.0",
    "vinext": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "htmlparser2": "^12.0.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "^0.8.3"
  }
}
